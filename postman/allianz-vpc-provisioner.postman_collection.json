  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Sign in (Cognito)' || pm.variables.get('idToken')) return;",
          "if (!pm.variables.get('password')) { console.warn('password is empty: set it (make demo-password) or run Auth > Sign in'); return; }",
          "pm.sendRequest({",
          "  url: 'https://cognito-idp.' + pm.variables.get('region') + '.amazonaws.com',",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/x-amz-json-1.1', 'X-Amz-Target': 'AWSCognitoIdentityProviderService.InitiateAuth' },",
          "  body: { mode: 'raw', raw: JSON.stringify({ AuthFlow: 'USER_PASSWORD_AUTH', ClientId: pm.variables.get('userPoolClientId'),",
          "    AuthParameters: { USERNAME: pm.variables.get('username'), PASSWORD: pm.variables.get('password') } }) }",
          "}, (err, res) => {",
          "  if (err || res.code !== 200) { console.error('Cognito sign-in failed', err || res.text()); return; }",
          "  pm.collectionVariables.set('idToken', res.json().AuthenticationResult.IdToken);",
          "});"
        ]
      }
    }
  ],
